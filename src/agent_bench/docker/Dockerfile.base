# syntax=docker/dockerfile:1
FROM oven/bun:1.3.14 AS bun
FROM node:22.19.0-bookworm

COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 python3-venv git bash curl ripgrep jq build-essential ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir \
        pytest==8.3.5 coverage==7.6.12 ruff==0.11.0 pyright==1.1.396 \
                debugpy==1.8.13 IPython==8.32.0 jupyter-client==8.6.3 ipykernel==6.29.5

# The Node image already owns UID/GID 1000; reuse it rather than colliding.
RUN groupmod -n bench node \
    && usermod -l bench -d /home/bench -m -s /bin/bash node \
    && mkdir -p /workspace /home/bench/.pi/agent /home/bench/.omp/agent \
        /home/bench/.config/opencode \
    && chown -R bench:bench /workspace /home/bench

ENV HOME=/home/bench \
    PATH=/opt/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

USER bench
WORKDIR /workspace
ENTRYPOINT []
CMD ["bash"]
