# syntax=docker/dockerfile:1
ARG BASE_IMAGE=agent-bench-base:local
FROM ${BASE_IMAGE}
ARG HARNESS_VERSION=0.99.2

USER root
RUN HOME=/root npm install --global --ignore-scripts "@earendil-works/pi-coding-agent@${HARNESS_VERSION}" \
    && HOME=/root npm cache clean --force \
    && chown -R bench:bench /home/bench

USER bench
WORKDIR /workspace
RUN pi --version
ENTRYPOINT []
CMD ["bash"]
