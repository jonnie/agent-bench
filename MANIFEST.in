include LICENSE README.md pyproject.toml MANIFEST.in
include CONTRIBUTING.md SECURITY.md CHANGELOG.md benchmark.example.json
recursive-include docs *.md
recursive-include examples *.md *.json *.html
recursive-include scripts *.py
recursive-include tests *.py
recursive-include .github/workflows *.yml
include .github/dependabot.yml .github/main-ruleset.json
recursive-include src/agent_bench/docker Dockerfile.*
recursive-include src/agent_bench/schemas *.json

# Allowlisted release inputs only; never ship local runs, environments, or secrets.
prune results
prune .venv
prune build
prune dist
prune .git
prune .mypy_cache
prune .pyright
prune .ruff_cache
global-exclude __pycache__ *.py[cod] .DS_Store .env .env.* *.pem *.key
