{
  "name": "Protect main",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/main"],
      "exclude": []
    }
  },
  "rules": [
    {"type": "deletion"},
    {"type": "non_fast_forward"},
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {"context": "Unit (ubuntu-latest, Python 3.11)", "integration_id": 15368},
          {"context": "Unit (ubuntu-latest, Python 3.13)", "integration_id": 15368},
          {"context": "Unit (macos-latest, Python 3.11)", "integration_id": 15368},
          {"context": "Lint and typecheck", "integration_id": 15368},
          {"context": "Build and isolated distribution smoke checks", "integration_id": 15368}
        ]
      }
    }
  ]
}
